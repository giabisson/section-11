[Unit]
Description=Section 11 primary bounded post-workout report scan

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/.local/share/section11-runtime/report_runner.py --profile %h/.local/share/section11-runtime/report-primary.json scan
UMask=0077
TimeoutStartSec=420
KillMode=control-group
NoNewPrivileges=true
